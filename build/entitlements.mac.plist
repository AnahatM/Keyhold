<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  NOT REFERENCED BY electron-builder.yml TODAY, and deliberately so.

  These entitlements only mean anything under the macOS hardened runtime, which Keyhold
  does not enable because it has no Developer ID certificate to sign with and no Apple
  Developer account to notarise through (decision D16, MANUAL-BACKLOG M4). Applying
  hardened-runtime entitlements to an ad-hoc signature produces launch failures, not
  security.

  The file exists so the day a certificate appears is a three-line change rather than a
  research task. To turn it on, in electron-builder.yml under `mac:`

      hardenedRuntime: true
      entitlements: build/entitlements.mac.plist
      entitlementsInherit: build/entitlements.mac.plist

  and set `notarize: true` with APPLE_API_KEY / APPLE_API_KEY_ID / APPLE_API_ISSUER in the
  environment.

  What each entitlement is for:
    allow-jit                        V8 compiles JavaScript at runtime.
    allow-unsigned-executable-memory V8 again; without it the renderer crashes on launch.
    disable-library-validation       Electron loads its own helper frameworks, which are
                                     signed with the same identity but not by Apple.

  Nothing here grants network, camera, microphone, location or file-system-wide access.
  Keyhold needs none of them, and an entitlement that is not requested cannot be abused.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
