{
  "name": "keyhold",
  "version": "0.1.0",
  "description": "A free, open-source, fully offline credential manager. Your passwords, in a file you own, encrypted with a key only you have.",
  "productName": "Keyhold",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Anahat Mudgal",
    "url": "https://github.com/AnahatM"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnahatM/Keyhold.git"
  },
  "homepage": "https://github.com/AnahatM/Keyhold",
  "bugs": {
    "url": "https://github.com/AnahatM/Keyhold/issues"
  },
  "keywords": [
    "password-manager",
    "credential-manager",
    "offline",
    "encryption",
    "argon2",
    "electron",
    "privacy",
    "local-first"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run lint && npm run build && npm test",
    "test:smoke": "node tools/smoke.mjs",
    "verify:full": "npm run format:check && npm run verify && npm run test:smoke"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "hash-wasm": "4.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
