# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-electron/
out/
release/
# NOT build/ — that folder holds electron-builder's INPUTS (icons, entitlements), not
# output. electron-vite writes out/ and electron-builder writes release/, both ignored
# below. Ignoring build/ meant it never reached a CI checkout, so every automated build
# would have been unbranded.
*.tsbuildinfo

# Packaging artefacts
*.exe
*.dmg
*.zip
*.AppImage
*.deb
*.rpm
*.blockmap
*.snap

# ─────────────────────────────────────────────────────────────
# NEVER COMMIT VAULT DATA. These are real people's passwords.
# ─────────────────────────────────────────────────────────────
*.keep
*.keepx
*.keepbak
*.keep.tmp
vaults/
# `tests/fixtures/**`, not `tests/**/fixtures/*`. The layout is tests/fixtures/<area>/<file>,
# so the old pattern required a `fixtures` directory whose *direct* child was the file and
# matched nothing. Ten import fixtures were therefore never committed; every test that reads
# one passed locally, where the files exist, and failed on every CI runner, where they do not.
!tests/fixtures/**/*.keep
!tests/fixtures/**/*.keepx

# Import/export fixtures that may contain real credentials
*.kdbx
*.csv
*.1pux
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.kdbx
!tests/fixtures/**/*.1pux

# Secrets & local config
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.cer
*.mobileprovision

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage
coverage/
.nyc_output/
.vitest/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Scratch
scratch/
tmp/
temp/
